post_install() {
    cat <<'EOF'
==> OmaRank: the engine is installed. To put the widget on the Omarchy bar run:
      omarchy plugin add https://github.com/ozdil/omarchy-omarank.git
      omarchy plugin enable ozdil.omarank
    (Omarchy loads bar widgets only from ~/.config/omarchy/plugins/.)
EOF
}

post_upgrade() {
    post_install
}
