#!/usr/bin/env bash
set -euo pipefail

# Prefer native Quickshell UI if available
if [[ "${1:-}" != "--cli" ]] && command -v quickshell >/dev/null 2>&1; then
    if quickshell ipc -p /usr/share/omarchy/shell call ozdil.omarank toggle >/dev/null 2>&1; then
        exit 0
    fi
fi

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BIN="${DIR}/omarank-engine"

if [[ ! -x "${BIN}" ]]; then
    if command -v omarank-engine >/dev/null 2>&1; then
        BIN="$(command -v omarank-engine)"
    elif [[ -f "${DIR}/Cargo.toml" ]] && command -v cargo >/dev/null 2>&1; then
        echo "Building omarank-engine from source..."
        (cd "${DIR}" && cargo build --release --quiet && cp "target/release/omarank-engine" "${BIN}" && chmod +x "${BIN}") || true
    fi
fi

if [[ ! -x "${BIN}" ]]; then
    echo "Error: omarank-engine binary not found. Please run 'cargo build --release' in ${DIR}"
    exit 1
fi

clear
"${BIN}"
echo ""
"${BIN}" --ladder
echo ""
echo -e "\x1b[1;36mPress [S] to submit anonymous survey to OmaStat, or [Q] to quit:\x1b[0m"
read -r -n 1 -s key || true
echo ""
if [[ "${key:-}" == "s" || "${key:-}" == "S" ]]; then
    "${BIN}" --submit-survey
    echo ""
    echo -e "\x1b[1;32mDone! Press Enter to exit.\x1b[0m"
    read -r || true
fi
