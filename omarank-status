#!/bin/bash -p
set -euo pipefail

# Immediate rejection of loader injection
if [ -n "${LD_PRELOAD:-}" ] || [ -n "${LD_LIBRARY_PATH:-}" ]; then
    echo "Security Error: Prohibited loader control variable detected" >&2
    exit 1
fi

# Re-exec through fixed trusted shell under sanitized environment (/usr/bin/env -i)
if [ "${OMARANK_SECURE_ENV:-0}" != "1" ]; then
    exec /usr/bin/env -i \
        PATH="/usr/bin:/bin:${HOME}/.local/bin:${HOME}/.cargo/bin" \
        HOME="${HOME}" \
        USER="${USER:-$(/usr/bin/id -un 2>/dev/null || echo "user")}" \
        LANG="${LANG:-C.UTF-8}" \
        LC_ALL="${LC_ALL:-C.UTF-8}" \
        XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(/usr/bin/id -u 2>/dev/null || echo 1000)}" \
        XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-${HOME}/.config}" \
        XDG_CACHE_HOME="${XDG_CACHE_HOME:-${HOME}/.cache}" \
        OMARANK_SECURE_ENV=1 \
        /bin/bash -p "$0" "$@"
fi

# Reject unexpected build and loader controls before building or launching
for var in LD_PRELOAD LD_LIBRARY_PATH RUSTC_WRAPPER CARGO_BUILD_RUSTC_WRAPPER RUSTFLAGS CARGO_ENCODED_RUSTFLAGS CARGO_HOME BASH_ENV ENV; do
    if [ -n "${!var+x}" ]; then
        echo "Security Error: Prohibited build/loader control variable detected: ${var}" >&2
        exit 1
    fi
done

DIR="$(cd "$(/usr/bin/dirname "$(/usr/bin/realpath "${BASH_SOURCE[0]}")")" && /usr/bin/pwd)"
BIN="${DIR}/omarank-engine"
STAMP="${DIR}/.engine-provenance"

# Resolve trusted cargo binary
CARGO_BIN=""
if [[ -x /usr/bin/cargo ]]; then
    CARGO_BIN="/usr/bin/cargo"
elif [[ -x "${HOME}/.cargo/bin/cargo" ]]; then
    CARGO_BIN="${HOME}/.cargo/bin/cargo"
fi

# Calculate expected source tree provenance hash (manifests, lockfile, and all Rust source files)
SOURCE_HASH=""
if [[ -d "${DIR}/src" && -f "${DIR}/Cargo.toml" && -f "${DIR}/Cargo.lock" ]]; then
    SOURCE_HASH="$(/usr/bin/find "${DIR}/src" "${DIR}/Cargo.toml" "${DIR}/Cargo.lock" -type f 2>/dev/null | /usr/bin/sort | /usr/bin/xargs /usr/bin/sha256sum 2>/dev/null | /usr/bin/sha256sum | /usr/bin/awk '{print $1}')"
fi

NEEDS_BUILD=1
if [[ -x "${BIN}" && -n "${SOURCE_HASH}" && -f "${STAMP}" ]]; then
    STORED_SRC=""
    STORED_BIN=""
    read -r STORED_SRC STORED_BIN < "${STAMP}" 2>/dev/null || true
    if [[ "${STORED_SRC}" == "${SOURCE_HASH}" && -n "${STORED_BIN}" ]]; then
        CURRENT_BIN_HASH="$(/usr/bin/sha256sum "${BIN}" 2>/dev/null | /usr/bin/awk '{print $1}')"
        if [[ "${CURRENT_BIN_HASH}" == "${STORED_BIN}" ]]; then
            NEEDS_BUILD=0
        fi
    fi
fi

if [[ "${NEEDS_BUILD}" -eq 1 && -n "${CARGO_BIN}" && -f "${DIR}/Cargo.toml" ]]; then
    TMP_BUILD_DIR="$(/usr/bin/mktemp -d -t omarank-build.XXXXXX)"
    cleanup() {
        /usr/bin/rm -rf "${TMP_BUILD_DIR}"
    }
    trap cleanup EXIT
    if (cd "${DIR}" && "${CARGO_BIN}" build --release --locked --quiet --target-dir "${TMP_BUILD_DIR}") >/dev/null 2>&1; then
        if /usr/bin/install -m 755 "${TMP_BUILD_DIR}/release/omarank-engine" "${BIN}" >/dev/null 2>&1; then
            NEW_BIN_HASH="$(/usr/bin/sha256sum "${BIN}" 2>/dev/null | /usr/bin/awk '{print $1}')"
            if [[ -n "${SOURCE_HASH}" && -n "${NEW_BIN_HASH}" ]]; then
                echo "${SOURCE_HASH} ${NEW_BIN_HASH}" > "${STAMP}" 2>/dev/null || true
            fi
        fi
    fi
fi

# Fail-closed execution gate: require verified source identity, binary existence, and digest binding
if [[ -z "${SOURCE_HASH}" ]]; then
    echo "Security Error: Source identity could not be computed" >&2
    exit 1
fi

if [[ ! -x "${BIN}" ]]; then
    echo '{"text":"OMARANK: OFFLINE","tooltip":"Engine binary missing or not executable (run cargo build --release --locked)","class":"alert"}'
    exit 1
fi

if [[ ! -f "${STAMP}" ]]; then
    echo "Security Error: Engine provenance stamp missing" >&2
    exit 1
fi

STORED_SRC=""
STORED_BIN=""
read -r STORED_SRC STORED_BIN < "${STAMP}" 2>/dev/null || true

if [[ "${STORED_SRC}" != "${SOURCE_HASH}" ]]; then
    echo "Security Error: Engine source provenance mismatch" >&2
    exit 1
fi

CURRENT_BIN_HASH="$(/usr/bin/sha256sum "${BIN}" 2>/dev/null | /usr/bin/awk '{print $1}')"
if [[ -z "${CURRENT_BIN_HASH}" || "${CURRENT_BIN_HASH}" != "${STORED_BIN}" ]]; then
    echo "Security Error: Engine binary provenance mismatch" >&2
    exit 1
fi

exec "${BIN}" --status


