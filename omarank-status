#!/usr/bin/env bash
set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BIN="${DIR}/omarank-engine"

if [[ ! -x "${BIN}" ]]; then
    if command -v omarank-engine >/dev/null 2>&1; then
        BIN="$(command -v omarank-engine)"
    elif [[ -f "${DIR}/Cargo.toml" ]] && command -v cargo >/dev/null 2>&1; then
        (cd "${DIR}" && cargo build --release --quiet && cp "target/release/omarank-engine" "${BIN}" && chmod +x "${BIN}") >/dev/null 2>&1 || true
    fi
fi

if [[ -x "${BIN}" ]]; then
    exec "${BIN}" --status
else
    echo '{"text":" OmaRank","tooltip":"OmaRank engine binary not found"}'
fi
